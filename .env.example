# Docker Compose (web/worker running in containers): use service hostnames
DATABASE_URL=postgres://postgres:postgres@db:5432/ordersdb
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=*

# Celery + Cache (Redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/0
PRODUCT_DETAIL_CACHE_TTL=300

# If you run Django directly on your host (not in Docker), switch hosts to localhost:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ordersdb
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# REDIS_CACHE_URL=redis://localhost:6379/0